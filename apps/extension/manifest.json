{
  "manifest_version": 3,
  "name": "Aether Vault",
  "version": "1.0.0",
  "description": "One-click save pages, links, and selections to your Aether Vault.",
  "permissions": ["activeTab", "contextMenus", "storage", "scripting", "cookies"],
  "host_permissions": ["http://127.0.0.1:4173/*", "https://*/*"],
  "action": {
    "default_title": "Save to Aether Vault",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-192.png",
      "48": "icons/icon-192.png",
      "128": "icons/icon-192.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png"
  }
}