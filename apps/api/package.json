{
  "name": "@vault/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/node.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/node.js",
    "start:local": "node --env-file=../../.env dist/node.js",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx --env-file=../../.env src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.741.0",
    "@aws-sdk/lib-storage": "3.741.0",
    "@aws-sdk/s3-request-presigner": "^3.741.0",
    "@hono/node-server": "^1.13.7",
    "@vault/shared": "workspace:*",
    "hono": "^4.6.16",
    "mongodb": "^6.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.167.0"
  }
}
